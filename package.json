{
  "name": "two-kings-chess",
  "version": "1.0.0",
  "license": "MIT",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:conventions": "node --test test/conventions.mjs",
    "check": "npm run typecheck && npm test && npm run test:conventions",
    "test:e2e": "CI=1 expo export --platform web --output-dir dist-web && node e2e/run.mjs",
    "e2e": "npm run test:e2e",
    "e2e:run": "node e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
