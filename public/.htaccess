# Two Kings Chess: Apache 2.4 (mod_rewrite, mod_headers, mod_mime). Netlify and Cloudflare Pages
# read _headers instead; nginx: see deploy/nginx.conf. The header values are the same in all of
# them, and src/__tests__/website.test.ts fails when they differ; _headers says what each is for.
# Apache never serves a file whose name starts with .ht, so this one is not published.
#
# The server configuration gives the folder what no .htaccess can set (README, "Deploy"):
# AllowOverride All, the modules (a stock Debian or Ubuntu Apache loads neither mod_rewrite nor
# mod_headers: `a2enmod rewrite headers`) and ServerTokens Prod. Nothing here is wrapped in
# <IfModule>: wrapped, a missing module skipped its rules without a word and the folder went out
# with no headers and no refusals; unwrapped, it is a 500 and a line in the error log.

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8
# A sub-path build (--base-url) rewrites these two addresses to the path it is served under.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

  AddType text/javascript .js
  AddType text/css .css
  AddType font/ttf .ttf
  AddType audio/wav .wav
  AddType image/x-icon .ico

  RewriteEngine On
  # everything over https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # The site's own files and nothing else; the empty path is the page itself. Every other
  # address answers 404: the repository's own files, .git, node_modules and any .env among them,
  # and every folder, so none is listed. The bundle and the assets are matched by the content
  # hash in their names. .well-known/ holds security.txt and the certificate checks a webroot
  # ACME client writes. api/config is the static answer for a site with no backend; with one,
  # the virtual host's ProxyPass for /api/ (ProxyPass is server configuration, which this file
  # cannot hold: README, "Sign-in and the shop") answers the whole of api/ before this file is read.
  RewriteRule !^(index\.html|404\.html|site\.css|guard\.js|favicon\.ico|robots\.txt|api/config|\.well-known/security\.txt|\.well-known/acme-challenge/[A-Za-z0-9_-]+|_expo/static/js/web/[A-Za-z0-9_-]+-[0-9a-f]{32}\.js|assets/([A-Za-z0-9_-]+/)+[A-Za-z0-9_-]+\.[0-9a-f]{32}\.[a-z0-9]+)?$ - [R=404,L]

  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), compute-pressure=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # Unconditional: env=HTTPS is set by mod_ssl alone, so behind a proxy that ends TLS it was
  # never sent. A browser ignores the header over plain http.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Revalidated on every load, except what carries a content hash in its name (the bundle,
  # index-<hash>.js, and the assets, <name>.<hash>.<ext>), which a new build renames.
  Header always set Cache-Control "no-cache"
  <FilesMatch "[.-][0-9a-f]{32}\.(js|ttf|wav)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
